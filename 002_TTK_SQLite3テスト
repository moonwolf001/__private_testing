import sqlite3
import tkinter as tk
from tkinter import ttk

# SQLite3データベースからデータを取得する関数
def fetch_data():
    # SQLite3データベースファイルに接続
    conn = sqlite3.connect('TEST02')
    cursor = conn.cursor()

    # DATAテーブルからデータを取得
    cursor.execute("SELECT * FROM DATA")
    rows = cursor.fetchall()

    # カラム名を取得
    column_names = [description[0] for description in cursor.description]

    conn.close()
    return column_names, rows

# データをTKinterのウィンドウに表示する関数
def display_data():
    column_names, rows = fetch_data()

    # メインウィンドウ
    root = tk.Tk()
    root.title("SQLite3 Query Results")

    # Treeviewウィジェットを作成
    tree = ttk.Treeview(root, columns=column_names, show="headings")

    # カラム名を設定
    for col in column_names:
        tree.heading(col, text=col)
        tree.column(col, width=150, anchor='center')  # カラム幅を調整

    # データを挿入
    for row in rows:
        tree.insert("", tk.END, values=row)

    # スクロールバーを追加
    scrollbar = ttk.Scrollbar(root, orient=tk.VERTICAL, command=tree.yview)
    tree.configure(yscrollcommand=scrollbar.set)
    scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
    tree.pack(expand=True, fill=tk.BOTH)

    # ウィンドウを表示
    root.mainloop()

# メイン関数の呼び出し
if __name__ == "__main__":
    display_data()
