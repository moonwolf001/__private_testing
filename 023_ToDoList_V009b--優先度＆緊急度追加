{$R *.lfm}

{ TForm1 }

procedure TForm1.Button1Click(Sender: TObject);
begin
  // 一時的にデータセットを閉じる
  SQLQuery1.Close;

  // INSERT クエリを設定して実行
  SQLQuery1.SQL.Text := 'INSERT INTO ToDoList1 (ToDo) VALUES (:ToDo)';
  SQLQuery1.Params.ParamByName('ToDo').AsString := Edit1.Text;
  SQLQuery1.ExecSQL;

  // トランザクションをコミットして変更を保存
  SQLTransaction1.Commit;

  // SELECT クエリに戻してデータセットを再度開く
  SQLQuery1.SQL.Text := 'SELECT * FROM ToDoList1';
  SQLQuery1.Open;

  // Edit1をクリア
  Edit1.Clear;

end;

