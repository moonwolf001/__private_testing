import sqlite3
import tkinter as tk

# SQLite3データベースからデータを取得する関数
def fetch_data():
    conn = sqlite3.connect('TEST02')
    cursor = conn.cursor()

    # DATAテーブルからデータを取得
    cursor.execute("SELECT * FROM DATA")
    rows = cursor.fetchall()

    # カラム名を取得
    column_names = [description[0] for description in cursor.description]

    conn.close()
    return column_names, rows

# データを表示する関数
def display_data():
    column_names, rows = fetch_data()

    # メインウィンドウ
    root = tk.Tk()
    root.title("SQLite3 Query Results")

    # ヘッダーを表示
    header_frame = tk.Frame(root)
    header_frame.pack(fill=tk.X)
    for col in column_names:
        label = tk.Label(header_frame, text=col, borderwidth=2, relief="groove", width=15)
        label.pack(side=tk.LEFT, padx=2, pady=2)

    # データをリストボックスに表示
    listbox_frame = tk.Frame(root)
    listbox_frame.pack(fill=tk.BOTH, expand=True)

    listboxes = []
    for col in column_names:
        lb = tk.Listbox(listbox_frame, width=15)
        lb.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=2, pady=2)
        listboxes.append(lb)

    # 各カラムごとにデータを追加
    for row in rows:
        for idx, value in enumerate(row):
            listboxes[idx].insert(tk.END, value)

    # ウィンドウを表示
    root.mainloop()

# メイン関数の呼び出し
if __name__ == "__main__":
    display_data()
